    "info": {
        "name": "CourtWatch Researcher API",
        "_postman_id": "cec9c263-1b59-47f0-8bdb-2665a939f986",
        "description": "Read-only API with anonymized, verified court-monitoring data from Kosovo, for approved researchers.",
        "schema": "https:\/\/schema.getpostman.com\/json\/collection\/v2.1.0\/collection.json"
    },
    "item": [
        {
            "name": "Cases",
            "description": "\nAnonymized, verified (approved or published) monitored cases.",
            "item": [
                {
                    "name": "List cases",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/v1\/cases",
                            "query": [
                                {
                                    "key": "type",
                                    "value": "criminal_corruption",
                                    "description": "Case type (e.g. criminal_corruption, civil).",
                                    "disabled": false
                                },
                                {
                                    "key": "court_id",
                                    "value": "1",
                                    "description": "Court id (see \/reference\/courts).",
                                    "disabled": false
                                },
                                {
                                    "key": "year",
                                    "value": "2024",
                                    "description": "Year in which any stage took place.",
                                    "disabled": false
                                },
                                {
                                    "key": "per_page",
                                    "value": "25",
                                    "description": "Items per page (max 100).",
                                    "disabled": false
                                },
                                {
                                    "key": "page",
                                    "value": "1",
                                    "description": "Page number.",
                                    "disabled": false
                                },
                                {
                                    "key": "lang",
                                    "value": "en",
                                    "description": "Language of the labels: sq (default) or en.",
                                    "disabled": false
