# CourtWatch — production environment example (see docs/DEPLOY.md).
# Copy to .env on the server and fill in real values there. Never commit the real file.

APP_NAME=CourtWatch
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://courtwatch.example.org
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Europe/Belgrade

APP_LOCALE=sq
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=sq,en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=courtwatch
DB_USERNAME=courtwatch
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_IDLE_WARNING_SECONDS=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=s3
ATTACHMENTS_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@courtwatch.example.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

BLIND_INDEX_KEY=

# Backups (spatie/laravel-backup): encrypted archives pushed to an off-site S3 bucket
BACKUP_ARCHIVE_PASSWORD=
BACKUP_DISK=backups
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=
BACKUP_AWS_BUCKET=
BACKUP_AWS_ENDPOINT=
BACKUP_NOTIFICATION_EMAIL=

API_RATE_LIMIT_PER_MINUTE=60

SEED_DEMO_DATA=false

# Legacy migration (only on the secure machine that runs `legacy:import`)
LEGACY_DB_DRIVER=mysql
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
