# CourtWatch — development environment example.
# Copy to .env (the dev container and `docker compose up` do this automatically).
# Placeholders only: never put real secrets in this file.

APP_NAME=CourtWatch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Europe/Belgrade

APP_LOCALE=sq
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_SUPPORTED_LOCALES=sq,en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=courtwatch
DB_USERNAME=courtwatch
DB_PASSWORD=change-me

# Legacy MySQL database (only used by `php artisan legacy:import`, see docs/MIGRATION.md).
# Use a read-only database user. Never point this at a copy stored in the repository.
LEGACY_DB_DRIVER=mysql
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=legacy
LEGACY_DB_USERNAME=legacy_readonly
LEGACY_DB_PASSWORD=change-me
LEGACY_DB_CHARSET=utf8mb4
LEGACY_IMPORT_STATUS=approved

# Idle timeout: the session expires after this many minutes without activity.
# Users get a warning modal with an "extend" button shortly before.
SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_IDLE_WARNING_SECONDS=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
ATTACHMENTS_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit in development: web UI on http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@courtwatch.test"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible storage (MinIO in development: console on http://localhost:9001)
AWS_ACCESS_KEY_ID=courtwatch
AWS_SECRET_ACCESS_KEY=change-me-minio
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=courtwatch
AWS_ENDPOINT=http://minio:9000
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Key used for the blind index that makes encrypted party names searchable.
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
BLIND_INDEX_KEY=

# Researcher API
API_RATE_LIMIT_PER_MINUTE=60

# Demo accounts are only seeded when APP_ENV is local/testing.
SEED_DEMO_DATA=true
DEMO_PASSWORD=password

VITE_APP_NAME="${APP_NAME}"

# Security headers and login limits (see .env.production.example)
CSP_MODE=enforce
HSTS_ENABLED=true
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15
TRUSTED_PROXIES=

# Backups: development keeps archives in storage/backups (production: off-site "backups" disk)
BACKUP_NAME=courtwatch
BACKUP_DISKS=backups_local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=admin@courtwatch.test
