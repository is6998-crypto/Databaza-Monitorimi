# --- Environment files: never commit secrets (only .env.example is tracked) ---
.env*
!.env.example
!.env.production.example

# --- Database dumps, backups and exports: never commit real data ---
*.sql
*.sql.gz
*.dump
*.bak
/migration/data/
/backups/
/exports/

# --- Tooling ---
.claude/settings.local.json
/test-results/
/playwright-report/
/e2e/.auth/
/storage/app/private/scribe/*.tmp
